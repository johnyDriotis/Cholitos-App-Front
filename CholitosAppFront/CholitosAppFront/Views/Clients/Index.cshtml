@using CholitosAppFront.Core.DTOs

@model List<ClientDto>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Listado de clientes";
}

<section class="content">
    <div class="container-fluid">
        <div class="block-header">
        </div>
        <!-- #END# Basic Examples -->
        <!-- Exportable Table -->
        <div class="row clearfix">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <div class="card">
                    <div class="header">
                        <button type="button" class="btn btn-primary waves-effect" id="btnNewClient" onclick="javascriptRedirect('/Client/AddClient')">
                            <i class="material-icons">library_add</i>
                            <span>Agregar cliente</span>
                        </button>
                    </div>
                    <div class="body">
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped table-hover dataTable js-exportable">
                                <thead>
                                    <tr>
                                        <th>Cliente</th>
                                        <th>Codigo gimnasio</th>
                                        <th>Nombre</th>
                                        <th>Operaciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var cliente in Model)
                                    {
                                        string btnClassEstado = cliente.Estado.Equals("A") ? "btn-success" : "btn-danger";

                                        <tr>
                                            <td>@cliente.CodigoCliente</td>
                                            
                                            <td>@cliente.PrimerNombre @cliente.SegundoNombre @cliente.PrimerApellido @cliente.SegundoApellido @cliente.ApellidoCasada</td>
                                            <td>
                                                <a type="button" class="btn btn-primary waves-effect" asp-controller="Client" asp-action="ModifyClient"
                                                   asp-route-idCliente="@cliente.CodigoCliente">Modificar</a>

                                                <button type="button" class="btn btn-danger waves-effect eliminar-cliente"
                                                        data-idCliente="@cliente.CodigoCliente"
                                                        data-nombreCompleto="@cliente.PrimerNombre @cliente.PrimerApellido">
                                                    Eliminar
                                                </button>

                                                <button type="button" class="btn @btnClassEstado waves-effect cambiar-estado"
                                                        data-idCliente="@cliente.CodigoCliente"
                                                        data-nombreCompleto="@cliente.PrimerNombre @cliente.PrimerApellido"
                                                        data-estado="@cliente.Estado">
                                                    Cambiar estado
                                                </button>
                                                <a type="button" class="btn btn-info waves-effect"
                                                        asp-controller="Client" asp-action="ClientDetails"
                                                        asp-route-idCliente="@cliente.CodigoCliente">
                                                    Detalles
                                                </a>

                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- #END# Exportable Table -->

    </div>
</section>

@section Scripts {
    <!-- Archivo js para pagina de index de clientes -->
    <script src="~/js/clients/index.js"></script>
}
